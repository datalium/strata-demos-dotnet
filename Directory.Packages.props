<Project>

  <!-- Central package management: every package version the demos use is set here, once.
       The demos build from Strata's published NuGet packages (https://www.nuget.org/packages/Datalium.Strata),
       not from a source checkout. Change StrataVersion to move every demo to another Strata release. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <StrataVersion>0.9.0-preview.1</StrataVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Datalium.Strata includes the [StrataTool] source generator, so a demo with tools needs no other reference. -->
    <PackageVersion Include="Datalium.Strata" Version="$(StrataVersion)" />
    <PackageVersion Include="Datalium.Strata.Storage" Version="$(StrataVersion)" />
    <PackageVersion Include="Datalium.Strata.AI" Version="$(StrataVersion)" />
    <PackageVersion Include="Datalium.Strata.Hosting" Version="$(StrataVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official OpenAI IChatClient (demos 03 and 06). Its version matches the
         Microsoft.Extensions.AI.Abstractions 10.10.1 that Datalium.Strata.AI references. -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <!-- The Generic Host itself (demo 28). Datalium.Strata.Hosting references only the abstractions. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <!-- FakeTimeProvider, for the demos that move a clock by hand instead of waiting. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

</Project>
