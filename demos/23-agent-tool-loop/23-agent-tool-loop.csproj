<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Datalium.Strata.Demos.AgentToolLoop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Datalium.Strata ships the [StrataTool] source generator as an analyzer, so the tools in
         SupportDesk.cs get their generated dispatch code with no other reference. -->
    <PackageReference Include="Datalium.Strata" />
    <!-- Datalium.Strata.AI brings Microsoft.Extensions.AI.Abstractions (IChatClient) with it. -->
    <PackageReference Include="Datalium.Strata.AI" />
    <PackageReference Include="Datalium.Strata.Storage" />
  </ItemGroup>

</Project>
