<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Datalium.Strata.Demos.AsyncAndCancellation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Datalium.Strata" />
    <PackageReference Include="Datalium.Strata.Storage" />
  </ItemGroup>

  <ItemGroup>
    <!-- A fake clock for node timeouts and the run deadline (RunOptions.TimeProvider), so the demo
         fires them on cue instead of waiting for real time to pass. Same version Strata's own tests use. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

</Project>
