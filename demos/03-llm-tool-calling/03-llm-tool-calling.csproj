<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Datalium.Strata.Demos.LlmToolCalling</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The official OpenAI IChatClient. The version matches the Microsoft.Extensions.AI.Abstractions
         10.10.1 that Datalium.Strata.AI references (and Strata's own live tests use it). -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <!-- Datalium.Strata ships the [StrataTool] source generator as an analyzer, so the tools in
         Tools.cs get their generated dispatch code with no other reference. -->
    <PackageReference Include="Datalium.Strata" />
    <PackageReference Include="Datalium.Strata.AI" />
    <PackageReference Include="Datalium.Strata.Storage" />
  </ItemGroup>

</Project>
