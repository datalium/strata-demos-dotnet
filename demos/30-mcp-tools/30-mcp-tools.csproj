<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Datalium.Strata.Demos.McpTools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Datalium.Strata ships the [StrataTool] source generator as an analyzer, so QuoteTools gets its generated
         dispatch code with no other reference. Datalium.Strata.Mcp is the MCP client (new in 1.0.0-rc.1). -->
    <PackageReference Include="Datalium.Strata" />
    <PackageReference Include="Datalium.Strata.Storage" />
    <PackageReference Include="Datalium.Strata.Mcp" />
  </ItemGroup>

</Project>
