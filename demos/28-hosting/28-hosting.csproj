<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Datalium.Strata.Demos.Hosting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Generic Host itself. Datalium.Strata.Hosting references only the abstractions. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- A fake clock, so a five-minute timer is due without waiting five minutes. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Datalium.Strata" />
    <PackageReference Include="Datalium.Strata.Storage" />
    <PackageReference Include="Datalium.Strata.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
