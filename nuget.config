<?xml version="1.0" encoding="utf-8"?>
<!-- Restore from nuget.org only, so the demos build the same on any machine:
     Strata's packages (Datalium.Strata*) are published there, with everything else. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
